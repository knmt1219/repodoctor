{
  "name": "@hominhtuan/repodoctor",
  "version": "0.1.4",
  "description": "Fast, zero-config Repository Health, Security & CI Linter for modern open-source projects. Diagnoses GitHub Actions misconfigurations, OSS governance, secret ignores, lockfile hygiene, and exports SARIF 2.1.0.",
  "keywords": [
    "linter",
    "repository-health",
    "github-actions",
    "security-scanner",
    "ci-cd",
    "open-source",
    "sarif",
    "code-quality",
    "devops",
    "pre-commit",
    "dependabot",
    "codeowners",
    "supply-chain-security",
    "oss-hygiene"
  ],
  "homepage": "https://github.com/knmt1219/repodoctor#readme",
  "bugs": {
    "url": "https://github.com/knmt1219/repodoctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knmt1219/repodoctor.git"
  },
  "license": "MIT",
  "author": "RepoDoctor Contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "repodoctor": "./bin/repodoctor.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "action.yml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/test-runner.js",
    "test:coverage": "npm run build && tsc -p tsconfig.test.json && node scripts/test-runner.js --coverage",
    "doctor": "node ./bin/repodoctor.js check .",
    "doctor:fix": "node ./bin/repodoctor.js fix .",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
}
